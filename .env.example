# Copy to .env and adjust. Used by `npm run dev`; docker compose reads SITE_ADMINS, GOOGLE_* and DEV_LOGIN from it too.
DATABASE_URL=postgres://bridgephone:bridgephone@localhost:5432/bridgephone
PORT=3000

# The URL people open in the browser. In development that is the Vite dev server.
APP_URL=http://localhost:5173

# Comma-separated emails of the site admins.
SITE_ADMINS=you@example.com

# Google sign-in (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Log in with just an email address, without Google. Never enable in production.
DEV_LOGIN=true
